# Порт, на котором запускается сервер
PORT=4000

# Секрет для подписи JWT-токенов — обязательно замени на свою длинную случайную строку в продакшене
JWT_SECRET=change-this-to-a-long-random-string

# Сколько живёт токен авторизации
JWT_EXPIRES_IN=7d

# Путь к файлу базы данных SQLite
DB_PATH=./data/turbo_chalakim.db

# Разрешённый origin для CORS (домен фронтенда)
CORS_ORIGIN=*
